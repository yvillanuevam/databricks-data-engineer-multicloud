table fact_pedido
	lineageTag: ea6fdfa5-72a8-53de-affe-d2c0c3066f26

	measure Pedidos = COUNTROWS(fact_pedido)
		formatString: #,##0
		lineageTag: 9de41d70-1ea5-549a-ad39-5a23f2236b7a

	measure 'Pedidos entregados' = SUM(fact_pedido[es_entregado])
		formatString: #,##0
		lineageTag: 18185153-01df-5f39-adf3-275cf0ccc73c

	measure 'Ventas entregadas' = SUM(fact_pedido[venta_entregada_pen])
		formatString: #,##0.00
		lineageTag: 46d5f0f8-dbfc-5c6d-baa7-066d131e7482

	measure Puntualidad = DIVIDE(SUM(fact_pedido[es_puntual]), [Pedidos entregados])
		formatString: 0.0%
		lineageTag: 23ccc0d8-81ce-5684-aa89-da2177908d23

	measure Cancelación = DIVIDE(SUM(fact_pedido[es_cancelado]), [Pedidos])
		formatString: 0.0%
		lineageTag: b7690eef-19fa-5f2a-b870-6328ea68667f

