	partition fact_pedido = m
		mode: import
		source =
				let
					Origen = LeerGold("fact_pedido", ""),
					SinVacios = if ModoDemo then Table.ReplaceValue(Origen, "", null, Replacer.ReplaceValue, {"dias_atraso", "fecha_entrega"}) else Origen,
					Tipos = Table.TransformColumnTypes(SinVacios, {{"pedido_id", type text}, {"fecha_pedido", type date}, {"sede_id", type text}, {"categoria_id", type text}, {"canal", type text}, {"revision", Int64.Type}, {"estado", type text}, {"unidades", Int64.Type}, {"importe_pedido_pen", Currency.Type}, {"venta_entregada_pen", Currency.Type}, {"es_entregado", Int64.Type}, {"es_puntual", Int64.Type}, {"es_cancelado", Int64.Type}, {"dias_atraso", Int64.Type}, {"fecha_promesa", type date}, {"fecha_entrega", type date}}, "en-US")
				in
					Tipos

	annotation PBI_ResultType = Table

